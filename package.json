{
    "name": "footyplanner",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.9",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "pnpm --filter @footyplanner/api dev",
        "build": "pnpm --filter @footyplanner/web build",
        "e2e": "pnpm --filter @footyplanner/web e2e",
        "deploy": "pnpm build && pnpm --filter @footyplanner/api deploy",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@footyplanner/eslint-plugin": "workspace:*",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0"
    }
}
