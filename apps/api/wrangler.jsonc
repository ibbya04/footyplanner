{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "footyplanner",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-01",
    "observability": { "enabled": true },
    // Static files are served without running the Worker; only /api/* reaches it.
    "assets": {
        "directory": "../web/legacy",
        "run_worker_first": ["/api/*"],
    },
    // Workers Cache: Cloudflare serves cached API responses, honouring Cloudflare-CDN-Cache-Control.
    "cache": { "enabled": true },
    "vars": {
        "ESPN_BASE": "https://site.api.espn.com/apis/site/v2/sports/soccer",
        "PHOTON_URL": "https://photon.komoot.io/api/",
    },
}
