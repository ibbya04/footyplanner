{
    "name": "@footyplanner/api",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/rpc/index.d.ts"
        }
    },
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "types": "wrangler types",
        "test": "vitest run",
        "typecheck": "wrangler types --check && tsc -p .",
        "build:rpc": "tsc -p tsconfig.rpc.json",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply footyplanner --local",
        "db:migrate:remote": "wrangler d1 migrations apply footyplanner --remote"
    },
    "dependencies": {
        "@footyplanner/shared": "workspace:*",
        "@hono/zod-validator": "^0.9.1",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.19",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.8.4",
        "drizzle-kit": "^0.31.11",
        "vitest": "^5.1.1",
        "wrangler": "^4.164.0"
    }
}
